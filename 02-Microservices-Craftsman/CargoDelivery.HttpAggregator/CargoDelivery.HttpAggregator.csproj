<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>CargoDelivery.HttpAggregator</RootNamespace>
  </PropertyGroup>

  <!--
    EXTEXP0001: RemoveAllResilienceHandlers() у Microsoft.Extensions.Http.Resilience 10.x
    позначений як експериментальний. Ми свідомо використовуємо його, щоб замінити глобальний
    конвеєр Polly із ServiceDefaults на клієнт-специфічний (короткий бюджет для некритичних
    залежностей / демо-параметри лабораторії стійкості).
  -->
  <PropertyGroup>
    <NoWarn>$(NoWarn);EXTEXP0001</NoWarn>
  </PropertyGroup>

  <!--
    XML-документація з /// коментарів контролерів показується у Swagger UI (summary, параметри).
    CS1591 ("немає XML-коментаря для публічного члена") вимкнено, щоб не вимагати коментарів скрізь.
  -->
  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Aspire\CargoDelivery.ServiceDefaults\CargoDelivery.ServiceDefaults.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.5.0" />
  </ItemGroup>

</Project>
