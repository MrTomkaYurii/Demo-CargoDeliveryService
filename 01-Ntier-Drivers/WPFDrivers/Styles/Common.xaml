<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ================================================================= -->
    <!-- ОФІЦІЙНА ПАЛІТРА КОЛЬОРІВ C# ТА .NET (PURPLE / VIOLET BRANDING)  -->
    <!-- ================================================================= -->

    <!-- Основні фірмові фіолетові відтінки .NET / C# -->
    <Color x:Key="CSharpBrandColor">#512BD4</Color>
    <SolidColorBrush x:Key="CSharpPrimaryBrush" Color="#512BD4" />
    <SolidColorBrush x:Key="CSharpPrimaryDarkBrush" Color="#371B96" />
    <SolidColorBrush x:Key="CSharpPrimaryLightBrush" Color="#6C44E8" />

    <SolidColorBrush x:Key="CSharpVioletBrush" Color="#7F52FF" />
    <SolidColorBrush x:Key="CSharpVioletSoftBrush" Color="#9A70FF" />
    <SolidColorBrush x:Key="CSharpDeepBackgroundBrush" Color="#160E2E" />
    <SolidColorBrush x:Key="CSharpHeaderDarkBrush" Color="#1F1340" />

    <!-- Пастельні лавандові фони та межі -->
    <SolidColorBrush x:Key="CSharpLavenderBgBrush" Color="#F5F3FF" />
    <SolidColorBrush x:Key="CSharpLavenderSurfaceBrush" Color="#FAF8FF" />
    <SolidColorBrush x:Key="CSharpLavenderCardBrush" Color="#EDE9FE" />
    <SolidColorBrush x:Key="CSharpLavenderBorderBrush" Color="#DDD6FE" />
    <SolidColorBrush x:Key="CSharpLavenderBorderDarkBrush" Color="#C4B5FD" />

    <!-- Текстові кольори -->
    <SolidColorBrush x:Key="CSharpTextPrimaryBrush" Color="#1E1338" />
    <SolidColorBrush x:Key="CSharpTextSecondaryBrush" Color="#645E7D" />
    <SolidColorBrush x:Key="CSharpTextLightBrush" Color="#DDD6FE" />

    <!-- Акцентні градієнти C# -->
    <LinearGradientBrush x:Key="CSharpHeroGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#1E113E" Offset="0.0" />
        <GradientStop Color="#371B96" Offset="0.5" />
        <GradientStop Color="#512BD4" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="CSharpButtonGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#512BD4" Offset="0.0" />
        <GradientStop Color="#7F52FF" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="CSharpBenchmarkGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#7C3AED" Offset="0.0" />
        <GradientStop Color="#C026D3" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="CSharpWinnerGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#EDE9FE" Offset="0.0" />
        <GradientStop Color="#F3E8FF" Offset="1.0" />
    </LinearGradientBrush>

    <!-- ================================================================= -->
    <!-- БАЗОВІ СТИЛІ ЕЛЕМЕНТІВ КЕРУВАННЯ                                -->
    <!-- ================================================================= -->

    <!-- Стиль текстових полів TextBox -->
    <Style TargetType="TextBox">
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="BorderBrush" Value="#C4B5FD" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="Background" Value="White" />
        <Setter Property="Foreground" Value="#1E1338" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- Стиль звичайних кнопок Button -->
    <Style TargetType="Button">
        <Setter Property="Padding" Value="14,6" />
        <Setter Property="Background" Value="#512BD4" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <!-- Стиль радіокнопок RadioButton -->
    <Style TargetType="RadioButton">
        <Setter Property="Foreground" Value="#2D1B69" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,14,0" />
    </Style>

    <!-- Стиль таблиць DataGrid -->
    <Style TargetType="DataGrid">
        <Setter Property="Background" Value="White" />
        <Setter Property="BorderBrush" Value="#DDD6FE" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="HorizontalGridLinesBrush" Value="#EDE9FE" />
        <Setter Property="RowBackground" Value="White" />
        <Setter Property="AlternatingRowBackground" Value="#FAF8FF" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="RowHeaderWidth" Value="0" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="#1E1338" />
    </Style>

    <!-- Стиль заголовків колонок DataGrid -->
    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="#371B96" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="BorderThickness" Value="0,0,1,0" />
        <Setter Property="BorderBrush" Value="#512BD4" />
    </Style>

    <Style TargetType="DataGridCell">
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>