<UserControl x:Class="WPFDrivers.Views.DriversView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:WPFDrivers.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:DriversViewModel}"
             mc:Ignorable="d" 
             d:DesignHeight="780" d:DesignWidth="1180"
             Background="#F5F3FF">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- 0. Фірмовий хедер C# / .NET -->
            <RowDefinition Height="Auto"/>
            <!-- 1. Панель управління (Архітектура + ORM + Дії) -->
            <RowDefinition Height="Auto"/>
            <!-- 2. Статус-бар запиту -->
            <RowDefinition Height="*"/>
            <!-- 3. Вкладки з даними -->
        </Grid.RowDefinitions>

        <!-- 0. ФІРМОВИЙ C# / .NET ХЕДЕР (Deep Purple Gradient) -->
        <Border Grid.Row="0" CornerRadius="10" Padding="18,14" Margin="0,0,0,12">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#1A0F38" Offset="0.0" />
                    <GradientStop Color="#371B96" Offset="0.55" />
                    <GradientStop Color="#512BD4" Offset="1.0" />
                </LinearGradientBrush>
            </Border.Background>
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Стилізована емблема C# -->
                    <Border Background="#7F52FF" CornerRadius="8" Width="42" Height="42" Margin="0,0,14,0" VerticalAlignment="Center">
                        <TextBlock Text="C#" FontSize="22" FontWeight="ExtraBold" Foreground="White" 
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Керування водіями" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF"/>
                            <Border Background="#6C44E8" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text=".NET 10 SHOWCASE" FontSize="10" FontWeight="Bold" Foreground="#DDD6FE"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Демонстрація архітектури: In-Process Direct BLL проти REST Web API | EF Core проти Dapper" 
                                   FontSize="12" Foreground="#C4B5FD" Margin="0,3,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Індикатори поточного стану в правому кутку -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Бейдж Архітектури -->
                    <Border Background="#2B1666" BorderBrush="#7F52FF" BorderThickness="1.5" CornerRadius="6" Padding="10,5" Margin="0,0,8,0">
                        <TextBlock Text="{Binding SelectedArchitecture, StringFormat='Режим: {0}'}" 
                                   Foreground="#DDD6FE" FontWeight="Bold" FontSize="12"/>
                    </Border>
                    <!-- Бейдж Провайдера -->
                    <Border Background="#2B1666" BorderBrush="#9A70FF" BorderThickness="1.5" CornerRadius="6" Padding="10,5">
                        <TextBlock Text="{Binding SelectedProvider, StringFormat='ORM: {0}'}" 
                                   Foreground="#E9D5FF" FontWeight="Bold" FontSize="12"/>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 1. ПАНЕЛЬ НАЛАШТУВАННЯ АРХІТЕКТУРИ ТА ДІЙ -->
        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#DDD6FE" BorderThickness="1.5" CornerRadius="10" Padding="16" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Рядок вибору: Архітектурний режим та ORM -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Архітектура -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,35,0">
                        <TextBlock Text="Архітектура:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="#2D1B69"/>
                        <RadioButton Content="Прямий BLL (In-Process)" GroupName="ArchGroup" 
                                     IsChecked="{Binding IsDirectMode}" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#371B96"/>
                        <RadioButton Content="REST Web API (HTTP)" GroupName="ArchGroup" 
                                     IsChecked="{Binding IsApiMode}" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#371B96"/>
                    </StackPanel>

                    <!-- ORM Провайдер -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="ORM / DAL:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="#2D1B69"/>
                        <RadioButton Content="Entity Framework Core" GroupName="OrmGroup" 
                                     IsChecked="{Binding IsEfProvider}" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#512BD4"/>
                        <RadioButton Content="ADO.NET + Dapper" GroupName="OrmGroup" 
                                     IsChecked="{Binding IsDapperProvider}" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#7C3AED"/>
                    </StackPanel>
                </Grid>

                <Separator Grid.Row="0" VerticalAlignment="Bottom" Background="#EDE9FE"/>

                <!-- Рядок параметрів та кнопок -->
                <WrapPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,10,0,0">
                    <!-- Поле ID Водія -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,15,4">
                        <TextBlock Text="ID Водія:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#2D1B69"/>
                        <TextBox Text="{Binding DriverId, UpdateSourceTrigger=PropertyChanged}" Width="75" Height="34" 
                                 VerticalContentAlignment="Center" HorizontalContentAlignment="Center" 
                                 FontSize="14" FontWeight="Bold" BorderBrush="#7F52FF" Background="#FAF8FF"/>
                    </StackPanel>

                    <!-- Кнопка: Завантажити водія (C# Brand Purple) -->
                    <Button Command="{Binding GetDriverCommand}" Content="🔍 Завантажити водія" 
                            Height="34" Padding="16,0" Background="#512BD4" Foreground="White" 
                            FontWeight="Bold" BorderThickness="0" Cursor="Hand" Margin="0,0,10,4"/>

                    <!-- Кнопка: Бенчмарк EF vs Dapper (Violet Gradient Accent) -->
                    <Button Command="{Binding RunBenchmarkCommand}" Content="⚡ Бенчмарк EF vs Dapper" 
                            Height="34" Padding="16,0" Foreground="White" 
                            FontWeight="Bold" BorderThickness="0" Cursor="Hand" Margin="0,0,10,4">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#7C3AED" Offset="0.0" />
                                <GradientStop Color="#9333EA" Offset="1.0" />
                            </LinearGradientBrush>
                        </Button.Background>
                    </Button>

                    <!-- Кнопка: Звіт витрат (Deep Violet) -->
                    <Button Command="{Binding GetExpenseSummaryCommand}" Content="💰 Звіт витрат" 
                            Height="34" Padding="14,0" Background="#4C1D95" Foreground="White" 
                            FontWeight="SemiBold" BorderThickness="0" Cursor="Hand" Margin="0,0,10,4"/>

                    <!-- Кнопка: Ліцензії що закінчуються (Dark Purple) -->
                    <Button Command="{Binding GetExpiringLicensesCommand}" Content="⚠️ Ліцензії (30 днів)" 
                            Height="34" Padding="14,0" Background="#3B0764" Foreground="White" 
                            FontWeight="SemiBold" BorderThickness="0" Cursor="Hand" Margin="0,0,10,4"/>
                </WrapPanel>
            </Grid>
        </Border>

        <!-- 2. СТАТУС-БАР З ЧАСОМ ВИКОНАННЯ (Lavender Card) -->
        <Border Grid.Row="2" Background="#FAF8FF" BorderBrush="#DDD6FE" BorderThickness="1.5" CornerRadius="8" Padding="14,8" Margin="0,0,0,10">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="● " Foreground="#7C3AED" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding StatusMessage}" Foreground="#2D1B69" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Час виконання: " Foreground="#645E7D" FontSize="12"/>
                    <Border Background="#EDE9FE" CornerRadius="4" Padding="6,2" Margin="4,0,0,0">
                        <TextBlock Text="{Binding LastExecutionTimeMs, StringFormat='{}{0:F1} мс'}" 
                                   Foreground="#512BD4" FontWeight="ExtraBold" FontSize="12"/>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 3. ВКЛАДКИ З РЕЗУЛЬТАТАМИ ТА АНАЛІТИКОЮ -->
        <TabControl Grid.Row="3" SelectedIndex="{Binding SelectedTabIndex}" Background="White" BorderBrush="#DDD6FE" BorderThickness="1.5">

            <!-- ВКЛАДКА 1: Профіль водія -->
            <TabItem Header="  👤 Профіль водія  " FontSize="14" FontWeight="Bold">
                <Grid Margin="15">
                    <!-- Заглушка, якщо водій не завантажений -->
                    <Border Visibility="{Binding DriverInfo, Converter={StaticResource InverseNullToVisibilityConverter}}"
                            Background="#FAF8FF" BorderBrush="#DDD6FE" BorderThickness="1" CornerRadius="8" Padding="40" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="📋 Дані водія ще не завантажені" FontSize="18" FontWeight="Bold" Foreground="#512BD4" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                            <TextBlock Text="Введіть ID водія вгорі та натисніть кнопку 'Завантажити водія' або 'Бенчмарк EF vs Dapper'." FontSize="13" Foreground="#645E7D" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Відображення профілю водія -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" 
                                  Visibility="{Binding DriverInfo, Converter={StaticResource NullToVisibilityConverter}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Ліва колонка: Особисті дані та Компанія/Авто -->
                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <!-- Картка: Особисті дані -->
                                <Border Background="#FFFFFF" BorderBrush="#DDD6FE" BorderThickness="1.5" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="Персональна інформація водія" FontSize="16" FontWeight="Bold" Foreground="#2D1B69" Margin="0,0,0,10"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="160"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="28"/>
                                                <RowDefinition Height="28"/>
                                                <RowDefinition Height="28"/>
                                                <RowDefinition Height="28"/>
                                                <RowDefinition Height="28"/>
                                            </Grid.RowDefinitions>

                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Прізвище:" FontWeight="SemiBold" Foreground="#645E7D"/>
                                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding DriverInfo.LastName}" FontWeight="Bold" Foreground="#1E1338"/>

                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Ім'я:" FontWeight="SemiBold" Foreground="#645E7D"/>
                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DriverInfo.FirstName}" FontWeight="Bold" Foreground="#1E1338"/>

                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="По батькові:" FontWeight="SemiBold" Foreground="#645E7D"/>
                                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DriverInfo.MiddleName, TargetNullValue='-'}"/>

                                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Дата народження:" FontWeight="SemiBold" Foreground="#645E7D"/>
                                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding DriverInfo.Birthdate, StringFormat='dd.MM.yyyy', TargetNullValue='-'}"/>

                                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Номер посвідчення:" FontWeight="SemiBold" Foreground="#645E7D"/>
                                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding DriverInfo.DriverLicenseNumber, TargetNullValue='-'}" FontWeight="Bold" Foreground="#512BD4"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Картка: Компанія та Тягач -->
                                <Border Background="#FFFFFF" BorderBrush="#DDD6FE" BorderThickness="1.5" CornerRadius="8" Padding="16">
                                    <StackPanel>
                                        <TextBlock Text="Компанія та Транспортний засіб" FontSize="16" FontWeight="Bold" Foreground="#2D1B69" Margin="0,0,0,10"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="160"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="28"/>
                                                <RowDefinition Height="28"/>
                                                <RowDefinition Height="28"/>
                                                <RowDefinition Height="28"/>
                                            </Grid.RowDefinitions>

                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Компанія:" FontWeight="SemiBold" Foreground="#645E7D"/>
                                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding DriverInfo.Company.CompanyName, TargetNullValue='Не призначено'}" FontWeight="Bold" Foreground="#1E1338"/>

                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Закріплене авто:" FontWeight="SemiBold" Foreground="#645E7D"/>
                                            <TextBlock Grid.Row="1" Grid.Column="1" FontWeight="Bold" Foreground="#1E1338">
                                                <TextBlock.Text>
                                                    <MultiBinding StringFormat="{}{0} {1}">
                                                        <Binding Path="DriverInfo.Truck.Brand" TargetNullValue="Немає" />
                                                        <Binding Path="DriverInfo.Truck.Model" TargetNullValue="" />
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>

                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Держномер:" FontWeight="SemiBold" Foreground="#645E7D"/>
                                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DriverInfo.Truck.LicensePlate, TargetNullValue='-'}"/>

                                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Вантажопідйомність:" FontWeight="SemiBold" Foreground="#645E7D"/>
                                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding DriverInfo.Truck.Capacity, TargetNullValue='-'}"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Права колонка: Журнал витрат водія -->
                            <Border Grid.Column="1" Background="#FFFFFF" BorderBrush="#DDD6FE" BorderThickness="1.5" CornerRadius="8" Padding="16" Margin="10,0,0,0">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Text="Журнал витрат водія" FontSize="16" FontWeight="Bold" Foreground="#2D1B69" Margin="0,0,0,10"/>
                                    <DataGrid ItemsSource="{Binding DriverInfo.Expenses}" AutoGenerateColumns="False" 
                                              HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                                            <DataGridTextColumn Header="Найменування" Binding="{Binding ExpenseName}" Width="*"/>
                                            <DataGridTextColumn Header="Сума ($)" Binding="{Binding ExpenseAmount, StringFormat='{}{0:N2}'}" Width="100"/>
                                            <DataGridTextColumn Header="Дата" Binding="{Binding ExpenseDate, StringFormat='dd.MM.yyyy'}" Width="100"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </DockPanel>
                            </Border>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- ВКЛАДКА 2: Порівняльний бенчмаркінг (EF Core vs Dapper) -->
            <TabItem Header="  ⚡ Порівняння EF Core vs Dapper  " FontSize="14" FontWeight="Bold">
                <Grid Margin="15">
                    <!-- Заглушка, якщо бенчмарк ще не запускали -->
                    <Border Visibility="{Binding BenchmarkResult, Converter={StaticResource InverseNullToVisibilityConverter}}"
                            Background="#FAF8FF" BorderBrush="#DDD6FE" BorderThickness="1" CornerRadius="8" Padding="40" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="⚡ Бенчмаркінг ще не виконувався" FontSize="18" FontWeight="Bold" Foreground="#512BD4" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                            <TextBlock Text="Натисніть кнопку '⚡ Бенчмарк EF vs Dapper' на панелі вгорі для прямого вимірювання швидкодії." FontSize="13" Foreground="#645E7D" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Відображення результатів бенчмаркінгу -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding BenchmarkResult, Converter={StaticResource NullToVisibilityConverter}}">
                        <StackPanel>
                            <!-- Банер переможця та зведення результату -->
                            <Border Background="#F5F3FF" BorderBrush="#C4B5FD" BorderThickness="2" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                                <DockPanel LastChildFill="False">
                                    <StackPanel DockPanel.Dock="Left">
                                        <TextBlock Text="🏆 Результат прямого порівняння швидкодії" FontSize="16" FontWeight="Bold" Foreground="#371B96"/>
                                        <TextBlock Margin="0,5,0,0" Foreground="#2D1B69" FontSize="13">
                                            <Run Text="Переможець за швидкістю: "/>
                                            <Run Text="{Binding BenchmarkResult.FasterProvider}" FontWeight="ExtraBold" Foreground="#512BD4"/>
                                            <Run Text=" | Коефіцієнт прискорення: "/>
                                            <Run Text="{Binding BenchmarkResult.SpeedupFactor, StringFormat='{}{0:F1}x'}" FontWeight="ExtraBold" Foreground="#7C3AED"/>
                                            <Run Text=" | "/>
                                            <Run Text="{Binding BenchmarkResult.Notes}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <!-- Порівняльні картки EF Core vs Dapper -->
                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Картка: Entity Framework Core -->
                                <Border Grid.Column="0" Background="#FAF8FF" BorderBrush="#C4B5FD" BorderThickness="1.5" CornerRadius="10" Padding="20" Margin="0,0,8,0">
                                    <StackPanel>
                                        <TextBlock Text="Entity Framework Core" FontSize="18" FontWeight="Bold" Foreground="#512BD4"/>
                                        <TextBlock Text="Full-Featured ORM (.NET 10)" FontSize="12" Foreground="#7F52FF" Margin="0,0,0,15"/>

                                        <TextBlock Text="Час виконання запиту:" FontSize="13" Foreground="#645E7D"/>
                                        <TextBlock Text="{Binding BenchmarkResult.EntityFrameworkExecutionTimeMs, StringFormat='{}{0:F2} мс'}" 
                                                   FontSize="32" FontWeight="Bold" Foreground="#512BD4" Margin="0,4,0,15"/>

                                        <Border Background="White" CornerRadius="6" Padding="12" BorderBrush="#DDD6FE" BorderThickness="1">
                                            <StackPanel>
                                                <TextBlock Text="Особливості виконання:" FontWeight="Bold" FontSize="12" Margin="0,0,0,6" Foreground="#2D1B69"/>
                                                <TextBlock Text="• LINQ з AsNoTracking()" FontSize="12" Foreground="#475569"/>
                                                <TextBlock Text="• Чотири JOIN зв'язки (.Include)" FontSize="12" Foreground="#475569"/>
                                                <TextBlock Text="• Автоматична матеріалізація об'єктного графа" FontSize="12" Foreground="#475569"/>
                                                <TextBlock Text="• Сувора типізація під час компіляції" FontSize="12" Foreground="#475569"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- Картка: ADO.NET + Dapper -->
                                <Border Grid.Column="1" Background="#FAF8FF" BorderBrush="#D8B4FE" BorderThickness="1.5" CornerRadius="10" Padding="20" Margin="8,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="ADO.NET + Dapper" FontSize="18" FontWeight="Bold" Foreground="#7C3AED"/>
                                        <TextBlock Text="High-Performance Micro-ORM (.NET 10)" FontSize="12" Foreground="#9333EA" Margin="0,0,0,15"/>

                                        <TextBlock Text="Час виконання запиту:" FontSize="13" Foreground="#645E7D"/>
                                        <TextBlock Text="{Binding BenchmarkResult.DapperExecutionTimeMs, StringFormat='{}{0:F2} мс'}" 
                                                   FontSize="32" FontWeight="Bold" Foreground="#7C3AED" Margin="0,4,0,15"/>

                                        <Border Background="White" CornerRadius="6" Padding="12" BorderBrush="#DDD6FE" BorderThickness="1">
                                            <StackPanel>
                                                <TextBlock Text="Особливості виконання:" FontWeight="Bold" FontSize="12" Margin="0,0,0,6" Foreground="#2D1B69"/>
                                                <TextBlock Text="• Оптимізований QueryMultipleAsync" FontSize="12" Foreground="#475569"/>
                                                <TextBlock Text="• Роздільні набори даних (без Cartesian Product)" FontSize="12" Foreground="#475569"/>
                                                <TextBlock Text="• Нульові накладні витрати трекінгу сутностей" FontSize="12" Foreground="#475569"/>
                                                <TextBlock Text="• Генерація IL-мапінгу на льоту" FontSize="12" Foreground="#475569"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- ВКЛАДКА 3: Фінансова аналітика та Ліцензії -->
            <TabItem Header="  📊 Фінансова аналітика та Ліцензії  " FontSize="14" FontWeight="Bold">
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <!-- Секція витрат -->
                        <RowDefinition Height="*"/>
                        <!-- Секція ліцензій -->
                    </Grid.RowDefinitions>

                    <!-- Секція 1: Звіт витрат -->
                    <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#DDD6FE" BorderThickness="1.5" CornerRadius="8" Padding="16" Margin="0,0,0,15">
                        <StackPanel>
                            <DockPanel LastChildFill="False" Margin="0,0,0,12">
                                <TextBlock DockPanel.Dock="Left" Text="Фінансовий аналітичний звіт водія" FontSize="16" FontWeight="Bold" Foreground="#2D1B69"/>
                                <Button DockPanel.Dock="Right" Command="{Binding GetExpenseSummaryCommand}" Content="Оновити звіт витрат" 
                                        Background="#512BD4" Foreground="White" BorderThickness="0" Cursor="Hand" Padding="12,5" FontWeight="SemiBold"/>
                            </DockPanel>

                            <!-- KPI картки показників -->
                            <Grid Visibility="{Binding ExpenseSummary, Converter={StaticResource NullToVisibilityConverter}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Картка 1: Загальна сума -->
                                <Border Grid.Column="0" Background="#FAF8FF" BorderBrush="#C4B5FD" BorderThickness="1.5" CornerRadius="8" Padding="12" Margin="0,0,8,0">
                                    <StackPanel>
                                        <TextBlock Text="Загальна сума витрат" FontSize="12" Foreground="#645E7D"/>
                                        <TextBlock Text="{Binding ExpenseSummary.GrandTotal, StringFormat='${0:N2}'}" 
                                                   FontSize="20" FontWeight="Bold" Foreground="#512BD4" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Картка 2: Середня сума -->
                                <Border Grid.Column="1" Background="#FAF8FF" BorderBrush="#C4B5FD" BorderThickness="1.5" CornerRadius="8" Padding="12" Margin="4,0,4,0">
                                    <StackPanel>
                                        <TextBlock Text="Середня витрата" FontSize="12" Foreground="#645E7D"/>
                                        <TextBlock Text="{Binding ExpenseSummary.AverageExpense, StringFormat='${0:N2}'}" 
                                                   FontSize="20" FontWeight="Bold" Foreground="#512BD4" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Картка 3: Витрати на пальне -->
                                <Border Grid.Column="2" Background="#FAF8FF" BorderBrush="#C4B5FD" BorderThickness="1.5" CornerRadius="8" Padding="12" Margin="4,0,4,0">
                                    <StackPanel>
                                        <TextBlock Text="Витрати на пальне" FontSize="12" Foreground="#645E7D"/>
                                        <TextBlock Text="{Binding ExpenseSummary.TotalFuelCost, StringFormat='${0:N2}'}" 
                                                   FontSize="20" FontWeight="Bold" Foreground="#7C3AED" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Картка 4: Кількість операцій -->
                                <Border Grid.Column="3" Background="#FAF8FF" BorderBrush="#C4B5FD" BorderThickness="1.5" CornerRadius="8" Padding="12" Margin="8,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Кількість витрат" FontSize="12" Foreground="#645E7D"/>
                                        <TextBlock Text="{Binding ExpenseSummary.ExpenseCount}" 
                                                   FontSize="20" FontWeight="Bold" Foreground="#7C3AED" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Секція 2: Сповіщення про ліцензії -->
                    <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#DDD6FE" BorderThickness="1.5" CornerRadius="8" Padding="16">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" LastChildFill="False" Margin="0,0,0,12">
                                <StackPanel DockPanel.Dock="Left">
                                    <TextBlock Text="Водії, термін дії посвідчення яких закінчується найближчим часом" FontSize="16" FontWeight="Bold" Foreground="#2D1B69"/>
                                    <TextBlock Text="Поріг сповіщення: 30 календарних днів" FontSize="12" Foreground="#645E7D"/>
                                </StackPanel>
                                <Button DockPanel.Dock="Right" Command="{Binding GetExpiringLicensesCommand}" Content="Оновити перелік" 
                                        Background="#512BD4" Foreground="White" BorderThickness="0" Cursor="Hand" Padding="12,5" FontWeight="SemiBold"/>
                            </DockPanel>

                            <DataGrid ItemsSource="{Binding ExpiringLicenses}" AutoGenerateColumns="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ID" Binding="{Binding DriverId}" Width="60"/>
                                    <DataGridTextColumn Header="ПІБ Водія" Binding="{Binding FullName}" Width="*"/>
                                    <DataGridTextColumn Header="Номер посвідчення" Binding="{Binding DriverLicenseNumber}" Width="160"/>
                                    <DataGridTextColumn Header="Дата закінчення" Binding="{Binding DriverLicenseExpirationDate, StringFormat='dd.MM.yyyy'}" Width="130"/>
                                    <DataGridTextColumn Header="Залишилось днів" Binding="{Binding DaysUntilExpiration}" Width="120"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
